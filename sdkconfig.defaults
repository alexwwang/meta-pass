# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# factory 缩至 0x170000(1.44MB);分区表保留 cardid@0x356000，二创不得移动或覆盖。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 编译器优化(瘦身) ---
# -Os:优化代码体积;Debug(-Og)体积大 ~20%。
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# 禁用 C++ 异常与 RTTI(启动器纯 C,但 IDF 组件可能链接 C++ 运行时)。
# 注:RTTI 由 COMPILER_CXX_RTTI=n 一并禁用(含 type_info)。
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
# 断言保留(开发期安全网),仅降级为非 fatal。
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# --- 日志(瘦身) ---
# 默认 WARN:INFO 级日志字符串占用大量 .rodata;按需用 esp_log_level_set() 临时调高。
# r10.7:默认 INFO(3)。WARN 会把 WiFi/网络组件自己的连接诊断编出二进制,
# 真机排障时串口无料可用;INFO 级的额外 flash 开销可忽略,排障价值远大于体积。
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL(瘦身裁剪) ---
CONFIG_LV_COLOR_DEPTH_16=y
# QR 码(meta_install QR 配对页)与 canvas 基类:lv_qrcode 基于 lv_canvas 实现,
# 裁 canvas 会连带裁掉 qrcode。I1 绘制默认开启,无需额外配置。
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_QRCODE=y
# 两种字体都在用:20px 供标题牌(ui_pixel_screen_create 每页标题),14px 供正文/行项。
# 16px 未使用,不启用。
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 内置 malloc 池大小(KB)。独立静态区,不与系统堆共享。
CONFIG_LV_MEM_SIZE_KILOBYTES=24
# 禁用 LVGL examples/demos(构建日志显示默认编入 1800+ 编译单元,占 ~2MB)。
CONFIG_LV_BUILD_EXAMPLES=n
# 禁用 LVGL 内置 demo。
# CONFIG_LV_USE_DEMO_WIDGETS is not set
# CONFIG_LV_USE_DEMO_MUSIC is not set
# CONFIG_LV_USE_DEMO_STRESS is not set
# CONFIG_LV_USE_DEMO_BENCHMARK is not set
# 裁剪未使用的 widget(启动器只用 label/button/panel/line/image)。
# CONFIG_LV_USE_ARC is not set
# CONFIG_LV_USE_ARCLABEL is not set
# CONFIG_LV_USE_CALENDAR is not set
# CONFIG_LV_USE_CALENDAR_HEADER_ARROW is not set
# CONFIG_LV_USE_CALENDAR_HEADER_DROPDOWN is not set
# CONFIG_LV_USE_CHART is not set
# CONFIG_LV_USE_CHECKBOX is not set
# CONFIG_LV_USE_DROPDOWN is not set
# CONFIG_LV_USE_IMAGEBUTTON is not set
# CONFIG_LV_USE_KEYBOARD is not set
# CONFIG_LV_USE_LED is not set
# CONFIG_LV_USE_LIST is not set
# CONFIG_LV_USE_MENU is not set
# CONFIG_LV_USE_MSGBOX is not set
# CONFIG_LV_USE_ROLLER is not set
# CONFIG_LV_USE_SCALE is not set
# CONFIG_LV_USE_SLIDER is not set
# CONFIG_LV_USE_SPAN is not set
# CONFIG_LV_USE_SPINBOX is not set
# CONFIG_LV_USE_SPINNER is not set
# CONFIG_LV_USE_SWITCH is not set
# CONFIG_LV_USE_TEXTAREA is not set
# CONFIG_LV_USE_TABLE is not set
# CONFIG_LV_USE_TABVIEW is not set
# CONFIG_LV_USE_TILEVIEW is not set
# CONFIG_LV_USE_WIN is not set
# CONFIG_LV_USE_THEME_SIMPLE is not set
# 禁用不需要的 draw 格式(ST7789 RGB565,不需要其他色深支持)。
# CONFIG_LV_DRAW_SW_SUPPORT_RGB888 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_XRGB8888 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888_PREMULTIPLIED is not set
# CONFIG_LV_DRAW_SW_SUPPORT_L8 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_AL88 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_A8 is not set

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
# --- OTA 槽位(meta-pass 多固件启动,3-Slot 架构) ---
# 分区表含 otadata + ota_0/ota_1/ota_2(见 partitions.csv)。
# 启用应用回滚(单次会话模型,2026-09-17):子固件由列表页引导后仅运行当前会话,
# ota 状态保持"待验证"且永不写 VALID(hook 不再调 cancel_rollback,启动器开机擦
# otadata 收编存量)——任何重启(崩溃/断电/看门狗)后 bootloader 自动回退 factory。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- 深睡唤醒"续玩"不需要额外 Kconfig(2026-09-24) ---
# 子固件按自身空闲超时(如 60s)息屏进 deep sleep 后,按键唤醒由本项目 bootloader
# hook(bootloader_components/meta_boot_hooks/)处理:把该槽位 PENDING_VERIFY 的
# otadata 副本续期为 VALID,bootloader 随即正常引导回该槽位。冷启动(断电/看门狗/
# 崩溃/软件重启)仍走 VALID 擦除策略,回 factory 列表页,单次会话模型不变。
#
# 曾尝试 CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y,已废弃:它把"上次引导的
# 分区"记在 RTC 快速内存顶部(rtc_retain_mem_t),而子固件各自的构建默认不含
# CONFIG_BOOTLOADER_RESERVE_RTC_MEM —— 其链接脚本不为 bootloader 预留该区域
# (RTC 定时器数据正好覆盖这条记录),子固件一运行记录即失效,快速引导静默回退
# 常规路径,仍回 factory(真机实测:唤醒后落到启动器列表页)。该选项要求每个
# 子固件配合,与 AGENTS.md"系统级策略不得委托子固件"冲突;改写 otadata 无此依赖。

# --- Bluetooth LE ---
# meta-pass 启动器不使用 BLE(Wi-Fi SoftAP 导入;BLE 协议栈占 ~150KB),整块移除。
# 子固件在各自分支自行配置。
# CONFIG_BT_ENABLED is not set
# CONFIG_BT_NIMBLE_ENABLED is not set

# --- LAN 上传通道(lwIP 窗口调优) ---
# LAN 上传收敛(lwIP 窗口调优):TCP 窗口 5760(4×MSS 默认)偏小;32KB 窗口
# 让手机 HTTP PUT 上传的 TCP 流更快灌满缓冲,配 48 个动态 RX 缓冲保留余量;
# LWIP_WND_SCALE 依赖 PSRAM(C3 无),不可用。SND_BUF 同步放大;RECVMBOX
# 32→64 保 RX 不掉队。r10.16 为 WAN 下载调的同一组值,通道切换后原样保留。
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=48
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
# r10.8(BUG-19 加固):TLS 重协商默认就不开 —— Kconfig 括号里写"不推荐",历史
# 版本曾因默认变量(全量 bundle)在菜单里翻到过 ON。显式钉死 = 攻击面与栈峰值可控。
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
