# main/Kconfig.projbuild —— meta-pass 启动器自身的构建期配置项。
# 会话超时同时提供运行时覆盖接口(meta_store_session_set_timeout_ms),见
# meta_store_net.h;此处为编译默认值,菜单:idf.py menuconfig → meta-pass launcher。

menu "meta-pass launcher"

    config META_STORE_SESSION_TIMEOUT_MS
        int "Store session timeout (ms)"
        default 1800000
        range 30000 86400000
        help
            商店流程无操作超时时间。到期不会直接关闭:先提示用户选择
            "OK = 保留会话 / OK LONG = 退出";上传(Preparing/Uploading)
            进行中每拍自动延续。

    config META_E2E_TEST_CONTROL
        bool "Enable USB test-only E2E control channel"
        default n
        help
            Enables a narrow USB Serial/JTAG control protocol for hardware E2E only.
            It can inspect the current slot/data registry and boot a validated slot.
            Keep disabled in production builds; it does not expose arbitrary flash I/O.

endmenu
